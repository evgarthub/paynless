{
  "name": "paynless-server",
  "version": "2.0.0",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:migrate-old": "bun run src/db/migrate-old-data.ts"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "@hono/swagger-ui": "^0.5.0",
    "drizzle-orm": "^0.36.0",
    "nanoid": "^5.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "drizzle-kit": "^0.28.0",
    "typescript": "^5.6.0"
  }
}
